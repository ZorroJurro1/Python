import tkinter as tk

def convert():
    c = float(entry.get())
    f = (9/5) * c + 32
    result.set(f"{f:.2f} °F")

root = tk.Tk()
root.title("Celsius to Fahrenheit")

entry = tk.Entry(root)
entry.pack()

result = tk.StringVar()
tk.Button(root, text="Convert", command=convert).pack()
tk.Label(root, textvariable=result).pack()
root.mainloop()
